# .ops/config.yaml -- one per project (schema v1). Copy to <repo>/.ops/config.yaml; `zouinify init` asks for the missing fields.
# Holds no secret: names, paths, branch names, window names, a budget number.
version: 1
project: {name: my-project, short: mp, root: /abs/path/to/my-project}
repos:
  - {name: backend,  path: .,            trunk: dev, prod: main, default: true}
  - {name: frontend, path: ../my-frontend, trunk: dev, prod: main}      # optional second repo
tickets:
  dir: tickets
  worktrees: .claude/worktrees
  states: default                       # the 11 states of the core; `custom:` is a later version
  deploy_kinds: [none, terraform, image+terraform, frontend, manual-aws]
  deploy_plugin: aws-terraform          # tickets/plugins/<plugin>.sh provides `apply`, `deploy-check` and the evidence regexes; `none` for a repo with no deploys
  ask_verbs: [APPLY, DEPLOY, PUSH, RUN, DECIDE, CHECK, APPROVE, SSO]
human_only:                             # printed into every brief and the CLAUDE.md section; the panel never runs them
  - terraform apply (production)
  - image pushes to the registry
  - the deploy script
  - any cloud write against the production account
  - git push to the prod branch; ff-merge into it
budget: {paid_usd_per_day: 10, approval_text: "T-{id} budget ok"}
model: fable
# model_re: '\[((?:Fable|Opus|Sonnet|Haiku|Claude)[^\]\n]*)\]'   # optional: how the model label is read from a pane's status bar (group 1)
sessions:
  desk:         {name: mp-desk,         tmux: mp-desk,         model: fable, permission_mode: auto, brief: .ops/briefs/desk.md,         always: true}
  manager:      {name: mp-manager,      tmux: mp-manager,      model: fable, permission_mode: auto, brief: .ops/briefs/manager.md,      always: true}
  debug:        {name: mp-debug,        tmux: mp-debug,        model: fable, permission_mode: auto, brief: .ops/briefs/debug.md,        always: true}
  chrome_debug: {name: mp-chrome-debug, tmux: mp-chrome-debug, model: fable, permission_mode: auto, brief: .ops/briefs/chrome_debug.md, flags: [--chrome], optional: true}
  worker:       {name: "t{num}-{slug}", tmux: "t{num}-{slug}", model: fable, permission_mode: auto,
                 prompt: "Read tickets/WORKER_BRIEF.md, then claim {id}."}
panel:
  port: 4790                            # `init` proposes 4700 + (crc32(root) % 90); `up` refuses a port held by anything else
  hook_port: 4792                       # the Claude Code hook listener, 127.0.0.1 only (default port + 2; port + 1 is the terminal page)
  bind: loopback                        # loopback | intranet  (intranet = 0.0.0.0, token mandatory on every request, link_host below)
  link_host: auto
  state_dir: .ops/state                 # gitignored: panel.json (port, pid, token hash), sessions.json, events.jsonl, audit.jsonl
  refresh_s: 30
  redact: default
  logs: []                              # log tails on the dashboard, e.g. [{label: "terraform apply", glob: "terraform/*.apply.log"}, {label: "site deploy", glob: ".deploy_site.log"}]
  plans_glob: ""                        # e.g. "terraform/*.tfplan": the newest file matching it is the only applicable plan, older ones are shown VOID; empty = no plan rule
terminal:                               # the terminal page: type into one of this project's Claude panes from the browser (user decision 2026-10-13)
  enabled: false                        # `zouinify term set-password` once in your own terminal, then `zouinify term start` (or `up` when autostart)
  port: 4791                            # default panel.port + 1; the bind mode follows panel.bind
  autostart: false
  targets: all                          # all | workers   (all = the desk and the role sessions too)
  exclude: []                           # session names never offered as a target
  idle_close_s: 300                     # an open terminal closes after this long without a keystroke
  max_open_s: 1800                      # and after this long regardless
aws:   {profile: default, sso_cache: ~/.aws/sso/cache, assumed_token_hours: 2}   # omit the block if the project has no cloud credentials to show
contact: {human: your-name}
