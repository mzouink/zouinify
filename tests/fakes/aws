#!/usr/bin/env python3
"""Fake `aws` for the zouinify test world (T-0178): `sts get-caller-identity` answers per $FAKE_AWS_MODE:
  ok       (default) prints the documentation example identity and exits 0
  expired  prints the CLI's SSO token error on stderr and exits 255
  denied   prints an AccessDenied-style error and exits 254
  hang     sleeps 10 s (the caller's 2 s timeout must fire)
Every invocation is appended to $FAKE_AWS_LOG (one JSON argv per line) when set, so a test can assert the exact
read-only command and how often it ran. Anything but sts get-caller-identity exits 2."""
import json
import os
import sys
import time

argv = sys.argv[1:]
log = os.environ.get("FAKE_AWS_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(argv) + "\n")
if argv[:2] != ["sts", "get-caller-identity"]:
    print(f"fake aws: unsupported command {argv[:2]}", file=sys.stderr)
    sys.exit(2)
mode = os.environ.get("FAKE_AWS_MODE", "ok")
if mode == "hang":
    time.sleep(10)
    sys.exit(0)
if mode == "expired":
    print("Error when retrieving token from sso: Token has expired and refresh failed", file=sys.stderr)
    sys.exit(255)
if mode == "denied":
    print("An error occurred (AccessDenied) when calling the GetCallerIdentity operation: not allowed", file=sys.stderr)
    sys.exit(254)
print(json.dumps({"UserId": "AIDAEXAMPLEFAKE", "Account": "123456789012",
                  "Arn": "arn:aws:sts::123456789012:assumed-role/example-role/example-session"}))
