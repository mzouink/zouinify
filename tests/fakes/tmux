#!/usr/bin/env python3
"""Fake `tmux` for the zouinify test world.

State lives in $FAKE_TMUX_STATE (a directory): sessions.json holds every "session" created with
new-session (its command argv, -e environment, -c cwd), calls.log records every invocation (one
JSON argv per line) so a test can assert what the CLI ran -- and what it never ran (send-keys).
capture-pane prints a Claude-like screen whose status bar names the model from the recorded
`--model` argument, or the contents of <state>/screen-<session>.txt when a test plants one.

Target semantics follow tmux: `=name` matches exactly; a bare `name` matches exactly, else the unique
session whose name starts with it (so an implementation that drops the `=` is caught by a test that
plants a `tp-desk-old` next to a missing `tp-desk`). $FAKE_TMUX_RACE=<name> makes `has-session` deny
that session although it exists, to simulate losing the check-then-launch race.
"""
import fcntl
import json
import os
import sys
import tempfile

STATE = os.environ["FAKE_TMUX_STATE"]
SESSIONS = os.path.join(STATE, "sessions.json")
MODEL_LABEL = {"fable": "Fable 5.1", "opus": "Opus 5.5", "sonnet": "Sonnet 5.5", "haiku": "Haiku 5.5"}


_LOCK = None


def lock():
    """One fake-tmux process at a time per state dir: a real tmux server serializes its commands, and two
    concurrent `launch` calls must never see a half-written sessions.json (a flaky CI run, 2026-10-13)."""
    global _LOCK
    if _LOCK is None:
        _LOCK = open(os.path.join(STATE, ".lock"), "a+")
        fcntl.flock(_LOCK.fileno(), fcntl.LOCK_EX)


def load():
    lock()
    try:
        with open(SESSIONS) as fh:
            return json.load(fh)
    except FileNotFoundError:
        return {}


def save(d):
    lock()
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".sessions.", suffix=".json")
    with os.fdopen(fd, "w") as fh:
        json.dump(d, fh, indent=1)
    os.replace(tmp, SESSIONS)


def log(argv):
    lock()
    with open(os.path.join(STATE, "calls.log"), "a") as fh:
        fh.write(json.dumps(argv) + "\n")


def resolve(d, args):
    """tmux -t resolution -> the session name, or None."""
    t = args[args.index("-t") + 1]
    exact = t.startswith("=")
    if exact:
        t = t[1:]
    for suffix in (":.", ":"):
        if t.endswith(suffix):
            t = t[: -len(suffix)]
    if t in d:
        return t
    if exact:
        return None
    cands = [n for n in d if n.startswith(t)]
    return cands[0] if len(cands) == 1 else None


def panes_of(d, name):
    """The main pane of a session (id %<pid>, command from cmd-<name>.txt / FAKE_TMUX_PANE_CMD) plus planted extra panes."""
    s = d[name]
    planted = os.path.join(STATE, f"cmd-{name}.txt")
    command = open(planted).read().strip() if os.path.exists(planted) else os.environ.get("FAKE_TMUX_PANE_CMD", "claude")
    extra_path = os.path.join(STATE, f"panes-{name}.json")
    extras = []
    if os.path.exists(extra_path):
        with open(extra_path) as fh:
            extras = json.load(fh)
    main_active = not any(e.get("active") for e in extras)
    override = os.path.join(STATE, f"panepid-{name}.txt")        # a respawned pane: same %id, a new pane pid
    pid = int(open(override).read().strip()) if os.path.exists(override) else s["pid"]
    rows = [{"id": f"%{s['pid']}", "pid": pid, "cmd": command, "active": main_active, "index": 0, "tty": f"/dev/pts/{s['pid']}"}]
    for i, e in enumerate(extras, 1):
        rows.append({"id": e.get("id", f"%{9000 + i}"), "pid": e.get("pid", 9000 + i), "cmd": e.get("cmd", "bash"), "active": bool(e.get("active")),
                     "index": i, "tty": e.get("tty", f"/dev/pts/{9000 + i}")})
    return rows


def session_of_pane(d, args):
    """`-t %id` -> the session owning that pane (main or planted), or None."""
    if "-t" not in args:
        return None
    t = args[args.index("-t") + 1]
    if not t.startswith("%"):
        return None
    for name in d:
        if any(p["id"] == t for p in panes_of(d, name)):
            return name
    return None


def main(argv):
    log(argv)
    sock = None
    while len(argv) >= 2 and argv[0] in ("-S", "-L"):      # a server other than the default one (T-0183): named by its socket
        sock = os.path.basename(argv[1])
        argv = argv[2:]
    if not argv:
        return 1
    cmd, args = argv[0], argv[1:]
    d = load()
    if cmd == "-V":
        print("tmux 3.4")
        return 0
    if cmd == "has-session":
        t = resolve(d, args)
        if t is not None and t != os.environ.get("FAKE_TMUX_RACE"):
            return 0
        print(f"can't find session: {args[args.index('-t') + 1]}", file=sys.stderr)
        return 1
    if cmd == "new-session":
        name = cwd = None
        env = {}
        i = 0
        while i < len(args):
            a = args[i]
            if a == "-d":
                i += 1
            elif a == "-s":
                name = args[i + 1]
                i += 2
            elif a == "-c":
                cwd = args[i + 1]
                i += 2
            elif a == "-e":
                k, v = args[i + 1].split("=", 1)
                env[k] = v
                i += 2
            else:
                break
        command = args[i:]
        if name is None:
            print("fake tmux: new-session needs -s", file=sys.stderr)
            return 1
        if name in d:
            print(f"duplicate session: {name}", file=sys.stderr)
            return 1
        d[name] = {"argv": command, "env": env, "cwd": cwd, "pid": 1000 + len(d)}
        save(d)
        return 0
    if cmd == "kill-session":
        t = resolve(d, args)
        if t is None:
            print(f"can't find session: {args[args.index('-t') + 1]}", file=sys.stderr)
            return 1
        del d[t]
        save(d)
        return 0
    if cmd == "capture-pane":
        t = resolve(d, args) or session_of_pane(d, args)
        if t is None:
            print(f"can't find pane: {args[args.index('-t') + 1]}", file=sys.stderr)
            return 1
        planted = os.path.join(STATE, f"screen-{t}.txt")
        if os.path.exists(planted):
            with open(planted, "rb") as fh:          # bytes through, like tmux: a test may plant non-UTF-8 output
                sys.stdout.buffer.write(fh.read())
            sys.stdout.flush()
            return 0
        s = d[t]
        a = s["argv"]
        model = a[a.index("--model") + 1] if "--model" in a else None
        label = MODEL_LABEL.get(model, model or "?")
        prompt = a[-1] if a else ""
        first = prompt.splitlines()[0][:120] if prompt else ""
        print(f"> {first}")
        print("")
        print("─" * 80)
        print(f"   [{label}] \U0001F4C1 {os.path.basename(s['cwd'] or '')} | \U0001F33F dev")
        print("   \U0001F4B0 $0.10 | ⏱️  1m | 1% ctx")
        print("  ⏵⏵ auto mode on (shift+tab to cycle)")
        return 0
    if cmd == "list-panes":
        # `-a`: the main pane of every session (what the panel reads); `-s -t =name`: EVERY pane of that session, the main
        # one plus the ones a test planted in panes-<name>.json ([{"id": "%9001", "cmd": "tmux", "active": 1, "pid": 9001}])
        # -- a split or a second window a worker could open (T-0181, review B1)
        fmt = args[args.index("-F") + 1]
        names = list(d)
        if "-s" in args:
            t = resolve(d, args)
            if t is None:
                print(f"can't find session: {args[args.index('-t') + 1]}", file=sys.stderr)
                return 1
            names = [t]
        for name in names:
            for p in (panes_of(d, name) if "-s" in args else panes_of(d, name)[:1]):
                print(fmt.replace("#{session_name}", name).replace("#{pane_pid}", str(p["pid"])).replace("#{pane_current_command}", p["cmd"])
                      .replace("#{pane_id}", p["id"]).replace("#{pane_active}", "1" if p["active"] else "0")
                      .replace("#{window_active}", "1").replace("#{window_index}", "0").replace("#{pane_index}", str(p["index"]))
                      .replace("#{pane_tty}", p["tty"]))
        return 0
    if cmd == "list-clients":
        # the server's own view of its attached clients (T-0183): the rows a test plants in <state>/clients.json (the
        # default server) or <state>/clients-<socket name>.json (`-S <dir>/<name>`): [{"pid": 7801, "tty": "/dev/pts/1001",
        # "session": "tp-desk"}]; a named socket without a file answers like tmux does when nothing listens there
        planted = os.path.join(STATE, "clients.json" if sock is None else f"clients-{sock}.json")
        if not os.path.exists(planted):
            if sock is not None:
                print(f"no server running on {sock}", file=sys.stderr)
                return 1
            return 0
        fmt = args[args.index("-F") + 1]
        with open(planted) as fh:
            rows = json.load(fh)
        for c in rows:
            print(fmt.replace("#{client_pid}", str(c.get("pid", 0))).replace("#{client_tty}", str(c.get("tty", "")))
                  .replace("#{session_name}", str(c.get("session", ""))))
        return 0
    if cmd == "list-sessions":
        for name in d:
            print(name)
        return 0
    if cmd == "show-environment":
        t = resolve(d, args)
        for k, v in d.get(t, {}).get("env", {}).items():
            print(f"{k}={v}")
        return 0
    if cmd == "send-keys":
        # FORBIDDEN by default (the CLI and the panel never type); the terminal page's tests opt in with
        # ZOUINIFY_FAKE_TMUX_ALLOW_SEND_KEYS=1 -- every call is in calls.log either way (T-0181)
        if os.environ.get("ZOUINIFY_FAKE_TMUX_ALLOW_SEND_KEYS") == "1":
            t = resolve(d, args) or session_of_pane(d, args)
            if t is None:
                print(f"can't find pane: {args[args.index('-t') + 1]}", file=sys.stderr)
                return 1
            planted = os.path.join(STATE, f"fail-send-{t}.txt")
            if os.path.exists(planted) and args and args[-1] == open(planted).read().strip():
                print("fake tmux: send-keys failed on purpose", file=sys.stderr)
                return 1
            return 0
        print("FORBIDDEN: send-keys", file=sys.stderr)
        return 2
    print(f"fake tmux: unsupported command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
